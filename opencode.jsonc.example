{
  // Copy to ~/.config/opencode/opencode.jsonc (or let scripts/serve-and-code.py patch it).
  // serve-and-code.py manages provider.vllm automatically: it sets the model you
  // pass via --model and autodetects the context limit from /v1/models.
  // Replace <MODEL_ID> and <CONTEXT_TOKENS> if you write this file by hand.
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM (DRAC)",
      "options": { "baseURL": "http://localhost:8000/v1" },
      "models": {
        "<MODEL_ID>": {
          "name": "<MODEL_ID>",
          "limit": { "context": "<CONTEXT_TOKENS>", "output": 8192 }
        }
      }
    }
  }
}
