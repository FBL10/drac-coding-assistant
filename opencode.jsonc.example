{
  // Copy to ~/.config/opencode/opencode.jsonc (or let scripts/serve-and-code.py patch it).
  // serve-and-code.py manages provider.vllm automatically; this is the shape it writes.
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM (DRAC)",
      "options": { "baseURL": "http://localhost:8000/v1" },
      "models": {
        "Qwen/Qwen3.8-27B-FP8": {
          "name": "Qwen/Qwen3.8-27B-FP8",
          "limit": { "context": 262144, "output": 8192 }
        }
      }
    }
  }
}
